# Mac y Ubuntu NO comparten red: cada maquina tiene su propio .env
#
# Mac (desarrollo) - red local, llega al AS/400 de la oficina:
#   FLASK_DEBUG=true
#   AS400_API_BASE_URL=http://192.168.0.100:10014/web/services/PEDIDOS
#
# Ubuntu (produccion) - otra red; el .env va SOLO en el servidor:
#   FLASK_DEBUG=false
#   AS400_API_BASE_URL=http://URL-AS400-DESDE-UBUNTU:10014/web/services/PEDIDOS
#
# El Ubuntu debe poder conectar al AS/400 (VPN, IP publica, túnel, etc.).
# Los usuarios entran a la app por la URL del Ubuntu, no por tu Mac.

FLASK_SECRET_KEY=cambiar-por-clave-larga-y-aleatoria
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5100

# Login multiusuario (fichero users.json; ver scripts/manage-users.py)
APP_USERS_FILE=users.json
APP_EMPRESAS_FILE=empresas.json
APP_SESSION_HOURS=8

# Solo si aún no tienes users.json (un usuario temporal en .env)
# APP_LOGIN_USER=admin
# APP_LOGIN_PASSWORD=cambiar-por-contraseña-segura

AS400_API_BASE_URL=http://192.168.0.100:10014/web/services/PEDIDOS
AS400_API_USER=usuario_api
AS400_API_PASSWORD=password_api

# Contabilidad / IAERP (asientos y plan de cuentas)
AS400_CONTABILIDAD_BASE_URL=http://80.28.249.31:10014/web/services/IAERP

# Asistente IA para asientos contables (opcional)
#
# --- Opción A: OpenAI (de pago) ---
# AI_ASIENTO_ENABLED=true
# AI_ASIENTO_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# --- Opción B: Ollama / modelo local (gratis, en tu PC o servidor) ---
# AI_ASIENTO_ENABLED=true
# AI_ASIENTO_PROVIDER=ollama
# AI_ASIENTO_BASE_URL=http://localhost:11434/v1
# AI_ASIENTO_MODEL=qwen3:latest
# AI_ASIENTO_TIMEOUT=180
#
# --- Opción C: Groq (nube, capa gratuita generosa) ---
# AI_ASIENTO_ENABLED=true
# AI_ASIENTO_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# AI_ASIENTO_MODEL=llama-3.1-8b-instant
# Alternativas: llama-3.3-70b-versatile, openai/gpt-oss-20b, qwen/qwen3-32b
# AI_ASIENTO_TIMEOUT=120
#
# --- Opción D: Google Gemini (nube, API compatible OpenAI) ---
# AI_ASIENTO_ENABLED=true
# AI_ASIENTO_PROVIDER=google
# GEMINI_API_KEY=AIza...
# AI_ASIENTO_MODEL=gemini-2.0-flash
# AI_ASIENTO_TIMEOUT=120
#
# --- Opción E: Anthropic Claude (nube, API compatible OpenAI) ---
# AI_ASIENTO_ENABLED=true
# AI_ASIENTO_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# AI_ASIENTO_MODEL=claude-sonnet-4-20250514
# AI_ASIENTO_TIMEOUT=120
# Alternativas: claude-3-5-haiku-latest, claude-3-5-sonnet-latest
#
# También puedes usar AI_ASIENTO_API_KEY en lugar de GROQ_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY.
# Alias aceptados: google/gemini, claude/anthropic
#
# Reglas extra para la IA (texto libre, opcional):
# AI_ASIENTO_REGLAS=Para pagos por Santander usar la cuenta de tesorería con SANTANDER en el nombre, no préstamos 170x.
#
# Ejemplos aprendidos de asientos confirmados (por empresa):
# APP_ASIENTOS_EJEMPLOS_FILE=asientos_ejemplos.json
# En el primer arranque se copia desde asientos_ejemplos.json.example si no existe.

# Historial de pedidos/asientos e idempotencia de confirmaciones:
# APP_HISTORIAL_FILE=historial_operaciones.json
