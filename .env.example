# Mac y Ubuntu NO comparten red: cada maquina tiene su propio .env
#
# Mac (desarrollo) - red local, llega al AS/400 de la oficina:
#   FLASK_DEBUG=true
#   AS400_API_BASE_URL=http://192.168.0.100:10014/web/services/PEDIDOS
#
# Ubuntu (produccion) - otra red; el .env va SOLO en el servidor:
#   FLASK_DEBUG=false
#   AS400_API_BASE_URL=http://URL-AS400-DESDE-UBUNTU:10014/web/services/PEDIDOS
#
# El Ubuntu debe poder conectar al AS/400 (VPN, IP publica, túnel, etc.).
# Los usuarios entran a la app por la URL del Ubuntu, no por tu Mac.

FLASK_SECRET_KEY=cambiar-por-clave-larga-y-aleatoria
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5100

AS400_API_BASE_URL=http://192.168.0.100:10014/web/services/PEDIDOS
AS400_API_USER=usuario_api
AS400_API_PASSWORD=password_api
