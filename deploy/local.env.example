# Copia a deploy/local.env y ajusta (ese fichero no se sube al servidor).
#
# Mac y Ubuntu en redes distintas: aqui pones la IP publica o dominio
# del Ubuntu, accesible por SSH desde tu Mac (VPN, puerto 22 abierto, etc.)

DEPLOY_HOST=ubuntu@tu-servidor.ejemplo.com
DEPLOY_PATH=/opt/pedidos_as400

# Si SSH no usa el puerto 22:
# DEPLOY_SSH_PORT=2222
